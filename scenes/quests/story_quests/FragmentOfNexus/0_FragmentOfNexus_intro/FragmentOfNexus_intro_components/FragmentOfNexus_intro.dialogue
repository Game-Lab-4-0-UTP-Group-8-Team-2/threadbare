~ start

do animation_player.play(&"walk_on")

do animation_player.animation_finished

do change_image(sierra_image)
[color=#2e8b99]SIERRA-7 [/color] \n...¿Dónde... estoy?
do change_image(bt_image)
[color=#ffa500]BT-1 [/color] \n(error de sistema...) Memoria... corrupta... 
do change_image(sierra_image)
[color=#2e8b99]SIERRA-7 [/color] \n¿Quién eres?... No, espera... yo... ¿quién soy?
do change_image(bt_image)
[color=#ffa500]BT-1 [/color] \n(recuperando conexión)... Unidad Sierra-7... vínculo dañado...

do animation_player.play(&"entry")

do animation_player.animation_finished
do change_image(alfa_image)
[color=#380273]ALFA-RECLUTA[/color] \n¡Hey! ¡Sierra-7! ¿Estás viva? ¡Resiste! Esta zona no es segura.
do change_image(sierra_image)
[color=#2e8b99]SIERRA-7 [/color] \n¿Eres... humano?
do change_image(alfa_image)
[color=#380273]ALFA-RECLUTA[/color] \nSí. Pero no es momento de hablar. Esa instalación se viene abajo.
do change_image(sierra_image)
[color=#2e8b99]SIERRA-7 [/color] \nBT... ¿puedes oírme?... algo me dice que ya hemos pasado por esto...
do change_image(bt_image)
[color=#ffa500]BT-1 [/color] \nAccediendo... fragmentos encontrados...
do change_image(alfa_image)
[color=#380273]ALFA-RECLUTA[/color] \n¡Muévanse! ¡Se vienen más patrullas!

do animation_player.play(&"walk_off")

do animation_player.animation_finished

do animation_player.play(&"exit")

do animation_player.animation_finished

=> END
